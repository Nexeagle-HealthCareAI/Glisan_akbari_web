{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "node --import tsx scripts/generate-assets.ts && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node --import tsx scripts/prerender.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "check:urls": "node --import tsx scripts/check-static-urls.ts",
    "preview:package": "esbuild preview-entry.tsx --bundle --minify --format=iife --define:import.meta.env='{}' --platform=browser --loader:.css=empty --outfile=site-preview-bundle.js && node scripts/package-site-preview.mjs",
    "check:seo": "node --import tsx scripts/check-priority-seo.ts",
    "assets:urology": "node --import tsx scripts/generate-urology-artwork.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.4",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
